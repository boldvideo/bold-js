#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
TIMEFORMAT='Completed in %3R seconds'

# The orb base image supplies Node.js; the SDK supports Node 20 and newer.
echo 'Checking Node.js and the repository-pinned pnpm version'
node -e 'if (Number(process.versions.node.split(".")[0]) < 20) throw new Error("Node.js >=20 is required")'
node --version
pnpm_version="$(node -p 'require("./package.json").packageManager.split("@")[1].split("+")[0]')"
if ! command -v pnpm >/dev/null 2>&1 || [[ "$(pnpm --version)" != "$pnpm_version" ]]; then
  time npm install --global "pnpm@$pnpm_version"
fi
pnpm --version

echo 'Installing locked dependencies (including development tools)'
time CI=true NODE_ENV=development pnpm install --frozen-lockfile --prefer-offline
